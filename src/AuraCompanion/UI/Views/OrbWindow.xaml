<!-- WinUI 3 Hitodama Floating Companion Orb Window -->
<Window
    x:Class="AuraCompanion.UI.Views.OrbWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AURA Companion Orb">

    <Grid Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Ambient Glow Backing -->
        <Ellipse
            x:Name="GlowEllipse"
            Width="64"
            Height="64"
            Fill="#66FCF1"
            Opacity="0.45" />

        <!-- Core Energy Particle Core -->
        <Ellipse
            x:Name="CoreEllipse"
            Width="48"
            Height="48"
            Fill="#45F3FF"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <!-- Hitodama Internal Light Highlight -->
        <Ellipse
            x:Name="HighlightEllipse"
            Width="20"
            Height="20"
            Fill="#FFFFFF"
            Opacity="0.75"
            Margin="0,6,12,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top" />
    </Grid>
</Window>
