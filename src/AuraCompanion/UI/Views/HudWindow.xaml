<!-- WinUI 3 Compact Desktop HUD Window -->
<Window
    x:Class="AuraCompanion.UI.Views.HudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AURA HUD">

    <Grid Background="#14171E" CornerRadius="16" Padding="16" Width="360" Height="84" BorderBrush="#1F2833" BorderThickness="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Status Dot Indicator -->
        <Ellipse
            x:Name="StatusDot"
            Grid.Column="0"
            Width="12"
            Height="12"
            Fill="#45F3FF"
            VerticalAlignment="Center"
            Margin="0,0,12,0" />

        <!-- Response / Dictation Stream Text -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock
                x:Name="TitleText"
                Text="AURA Ready"
                FontWeight="SemiBold"
                FontSize="14"
                Foreground="#FFFFFF" />
            <TextBlock
                x:Name="SubtitleText"
                Text="Press Win+Space to talk or type"
                FontSize="12"
                Foreground="#C5C6C7"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Quick Action / Expand Button -->
        <Button
            x:Name="ExpandButton"
            Grid.Column="2"
            Content="Expand"
            Background="#1F2833"
            Foreground="#45F3FF"
            CornerRadius="8"
            Padding="10,4"
            VerticalAlignment="Center" />
    </Grid>
</Window>
