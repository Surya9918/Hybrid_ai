<!-- WinUI 3 Application Launcher Window -->
<Window
    x:Class="AuraCompanion.UI.Views.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AURA Launcher">

    <Grid Background="#14171E" CornerRadius="16" Padding="16" Width="520" Height="380" BorderBrush="#1F2833" BorderThickness="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchBox" PlaceholderText="Search applications, files, commands..." FontSize="16" Background="#0B0C10" Foreground="#FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" />

        <ListView x:Name="ResultsList" Grid.Row="1">
            <!-- Bound search results -->
        </ListView>
    </Grid>
</Window>
