<!-- WinUI 3 Screen Region Selection Overlay Window -->
<Window
    x:Class="AuraCompanion.UI.Views.SelectionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AURA Screen Selection">

    <Grid Background="#330B0C10">
        <!-- Canvas for drawing selection marquee / circle -->
        <Canvas x:Name="OverlayCanvas">
            <Rectangle
                x:Name="SelectionRectangle"
                Stroke="#45F3FF"
                StrokeThickness="2"
                Fill="#2245F3FF"
                Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
