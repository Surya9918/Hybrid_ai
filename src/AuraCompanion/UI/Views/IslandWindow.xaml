<!-- WinUI 3 Expandable Dynamic Desktop Island Window -->
<Window
    x:Class="AuraCompanion.UI.Views.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AURA Desktop Island">

    <Grid Background="#0B0C10" CornerRadius="20" Padding="20" Width="480" Height="360" BorderBrush="#1F2833" BorderThickness="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="AURA Island" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Local AI Offline" Foreground="#4EFF9B" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="✕" Background="Transparent" Foreground="#C5C6C7" Padding="4" />
            </StackPanel>
        </Grid>

        <!-- Conversation / Tasks Pivot -->
        <Pivot Grid.Row="1">
            <PivotItem Header="Conversation">
                <ScrollViewer>
                    <StackPanel x:Name="ConversationList" Spacing="10">
                        <Border Background="#14171E" CornerRadius="10" Padding="12">
                            <TextBlock Text="How can I assist your workflow on Windows ARM64 today?" Foreground="#FFFFFF" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Tasks &amp; Reminders">
                <ScrollViewer>
                    <StackPanel x:Name="TasksList" Spacing="8">
                        <TextBlock Text="Active Tasks" FontWeight="SemiBold" Foreground="#45F3FF" Margin="0,4" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <!-- Input Bar -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" PlaceholderText="Ask AURA or schedule a task..." Background="#14171E" Foreground="#FFFFFF" CornerRadius="8" Padding="10,6" />
            <Button Grid.Column="1" Content="Send" Background="#45F3FF" Foreground="#0B0C10" FontWeight="SemiBold" CornerRadius="8" Margin="8,0,0,0" Padding="16,6" />
        </Grid>
    </Grid>
</Window>
