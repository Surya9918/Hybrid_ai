<!-- WinUI 3 Settings & Privacy Configuration Window -->
<Window
    x:Class="AuraCompanion.UI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AURA Companion Settings &amp; Privacy">

    <Grid Background="#0B0C10" Padding="24" Width="600" Height="500">
        <ScrollViewer>
            <StackPanel Spacing="20">
                <TextBlock Text="Settings &amp; Privacy Controls" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />

                <!-- Offline Enforcement -->
                <Border Background="#14171E" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <ToggleSwitch x:Name="OfflineToggle" Header="Enforce Strict Offline Mode" IsOn="true" Foreground="#FFFFFF" />
                        <TextBlock Text="Blocks all outbound network connections. AI runs 100% locally on device." FontSize="12" Foreground="#C5C6C7" />
                    </StackPanel>
                </Border>

                <!-- Local Hardware & NPU Acceleration -->
                <Border Background="#14171E" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Hardware Acceleration (Snapdragon X Elite)" FontWeight="SemiBold" Foreground="#45F3FF" />
                        <TextBlock x:Name="NpuStatusText" Text="Qualcomm Hexagon NPU: Active via Qualcomm QNN EP" Foreground="#4EFF9B" />
                        <TextBlock Text="Local Model: Phi-3.5-mini-instruct-Q4_K_M.gguf" Foreground="#C5C6C7" />
                    </StackPanel>
                </Border>

                <!-- Data & Privacy Wipe -->
                <Border Background="#14171E" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Data Ownership &amp; Privacy" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <Button Content="Export Local Data (.json)" Background="#1F2833" Foreground="#FFFFFF" CornerRadius="8" Padding="12,6" />
                        <Button Content="Nuclear Delete All Data" Background="#FF4E64" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="8" Padding="12,6" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
